{
  "permissions": {
    "allow": [
      "mcp__aws-mcp__aws___call_aws",
      "mcp__aws-mcp__aws___search_documentation",
      "mcp__terraform__get_latest_provider_version",
      "mcp__terraform__search_providers",
      "mcp__terraform__get_provider_details",
      "WebFetch(domain:www.terraform-best-practices.com)",
      "Bash(terraform fmt *)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(terraform init *)",
      "Bash(echo \"EXIT_INIT:$?\")",
      "Bash(terraform validate *)",
      "Bash(echo \"EXIT_VALIDATE:$?\")",
      "Bash(aws sts *)",
      "Bash(terraform plan *)",
      "Bash(terraform apply *)",
      "Bash(curl -s https://checkip.amazonaws.com)",
      "Bash(python3 -c \"import json;d=json.load\\(open\\('terraform.tfstate'\\)\\);print\\('resources:',len\\(d.get\\('resources',[]\\)\\),'serial:',d.get\\('serial'\\),'backend:',d.get\\('backend',{}\\).get\\('type','none'\\)\\)\")",
      "mcp__terraform__get_provider_capabilities",
      "Bash(aws s3 ls *)",
      "Bash(aws s3api get-bucket-versioning *)",
      "Bash(aws s3api get-bucket-encryption *)",
      "Bash(aws s3api get-public-access-block *)",
      "Bash(aws s3api *)",
      "Bash(python3 -m json.tool)",
      "Bash(terraform output *)"
    ]
  },
  "enabledMcpjsonServers": [
    "aws-mcp",
    "terraform"
  ]
}
